{
  "version": "0.1.0-alpha.1",
  "totalPoints": 100,
  "scoringPolicy": "Score only observed evidence. Mark unavailable widths, states and interactions unverified. A total never cancels a blocker.",
  "blockerRuleIds": ["LAY-002", "COL-001", "INT-001", "STA-001", "A11Y-001", "A11Y-003"],
  "categories": [
    {
      "id": "task-hierarchy-content",
      "points": 15,
      "checks": ["Primary job and next action are evident", "Content follows decision order", "Labels describe outcomes", "Redundant helper copy is absent"]
    },
    {
      "id": "system-components-tokens",
      "points": 15,
      "checks": ["Installed components are reused", "Semantic tokens are used", "One icon/type/radius/shadow system", "No kit internals are overridden"]
    },
    {
      "id": "grid-density-responsive",
      "points": 15,
      "checks": ["Shared edges and baselines", "4 px base / 8 px primary rhythm", "Consistent density", "Wide/medium/narrow transformations", "No content loss"]
    },
    {
      "id": "color-typography-polish",
      "points": 10,
      "checks": ["Semantic color roles", "Readable type hierarchy", "Selection/status/severity distinction", "Optical icon and text alignment", "Theme consistency"]
    },
    {
      "id": "interaction-accessibility",
      "points": 20,
      "checks": ["Semantic structure and names", "Keyboard and focus", "APG component behavior", "Contrast and non-color cues", "Zoom/reflow/targets", "Reduced motion"]
    },
    {
      "id": "states-feedback-recovery",
      "points": 15,
      "checks": ["Applicable state inventory", "Errors preserve context and recover", "Pending actions prevent duplicates", "Success confirms changed entity", "Partial and stale data remain honest"]
    },
    {
      "id": "data-display-evidence",
      "points": 10,
      "checks": ["Metrics name unit/timeframe/basis", "Charts have labels or alternatives", "Tables sort and paginate conventionally", "Claims route to evidence", "Data density remains readable"]
    }
  ],
  "deductions": {
    "major": "Deduct 3-8 points from the relevant category depending on scope.",
    "minor": "Deduct 1-2 points from the relevant category.",
    "repeated": "Deduct once for the systemic cause and list affected locations; do not inflate scores by counting every instance."
  },
  "interpretation": [
    {"range": "90-100", "label": "Strong candidate", "condition": "No blocker and no unverified primary flow"},
    {"range": "75-89", "label": "Usable after focused corrections", "condition": "No blocker"},
    {"range": "60-74", "label": "Material redesign needed", "condition": "Advisory review"},
    {"range": "0-59", "label": "Does not meet the contract", "condition": "Advisory review"}
  ]
}
