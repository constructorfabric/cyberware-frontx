{
  "version": "0.1.0-alpha.1",
  "kitGuaranteed": "Focus rings, focus trapping and return, Escape and outside-press dismissal, popup positioning, keyboard navigation, tab semantics, and label/description/error wiring come from @gears-frontx/ui-kit (Base UI) by construction and are not re-listed as screen obligations. They hold only while the kit component is used unmodified; bypassing the kit or duplicating its primitives is already prohibited by the design contract, and verify-interface still observes the rendered result.",
  "globalStates": ["default", "hover", "active", "focus-visible", "disabled"],
  "families": [
    {
      "id": "button-link",
      "additionalStates": ["loading", "destructive", "visited-link"],
      "required": ["semantic element", "specific accessible name", "pending feedback", "disabled reason when non-obvious"]
    },
    {
      "id": "field",
      "additionalStates": ["filled", "read-only", "required", "invalid", "valid", "loading"],
      "keyboard": ["Error summary moves focus only on explicit submission"],
      "required": ["persistent label", "associated error", "value preserved after recoverable failure"]
    },
    {
      "id": "select-combobox",
      "additionalStates": ["open", "selected", "empty", "invalid", "loading"]
    },
    {
      "id": "menu-popover-dialog",
      "additionalStates": ["open", "closing", "scrollable", "error"],
      "keyboard": ["Escape dismisses only when dismissal is safe"]
    },
    {
      "id": "tabs",
      "additionalStates": ["selected", "loading-panel", "disabled-tab"]
    },
    {
      "id": "table-grid",
      "additionalStates": ["selected-row", "sorted", "filtered", "loading", "empty", "partial", "error"],
      "keyboard": ["Interactive grid uses APG grid navigation"],
      "required": ["header association", "aria-sort on sorted header", "pagination when partial", "selection distinct from focus and status", "column-control label"]
    },
    {
      "id": "tree",
      "additionalStates": ["expanded", "collapsed", "selected", "loading-branch", "empty-branch"],
      "keyboard": ["Follow WAI-ARIA APG tree-view conventions"],
      "required": ["level and expansion semantics", "selected state distinct from focus", "full-row hit area", "compact repeated rhythm"]
    },
    {
      "id": "card-widget",
      "additionalStates": ["interactive", "loading", "empty", "partial", "stale", "error"],
      "keyboard": ["Interactive card has one semantic target or explicit internal controls"],
      "required": ["meaningful boundary", "shared family anatomy", "metric basis", "state", "evidence or drill-down"]
    },
    {
      "id": "inspector",
      "additionalStates": ["open", "loading", "empty-selection", "stale", "error"],
      "keyboard": ["Opening moves focus only when interaction requires it", "Closing returns focus to selected entity"],
      "required": ["selected entity identity", "close control", "consequential action before diagnostics", "responsive layer or route behavior", "URL-addressable selection when routing exists"]
    }
  ],
  "combinationChecks": [
    "selected + hover",
    "selected + focus-visible",
    "selected + semantic status",
    "disabled + reason",
    "loading + cancellation or safe waiting",
    "stale + partial data",
    "narrow viewport + open overlay",
    "zoom + sticky or floating content",
    "reduced motion + spatial transition"
  ]
}
