{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.test.{mjs,ts}"
      ],
      "project": [
        "scripts/**/*.{ts,mjs}",
        "!scripts/manual-auth-tests/**"
      ]
    },
    "packages/cli": {
      "ignore": ["templates/**", "template-sources/**"]
    },
    "packages/cyber-pilot-kit-frontx": {
      "entry": ["skills/**/scripts/*.mjs"]
    },
    "packages/ui-kit": {
      "entry": [
        "src/index.ts",
        "demo/main.tsx",
        "demo/examples/*.tsx",
        "demo/vite-env.d.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "demo/**/*.{ts,tsx}",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": ["esbuild"]
    }
  },
  "ignore": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/dist/**",
    "**/node_modules/**",
    "**/templates/**",
    "**/template-sources/**",
    "**/*.config.{ts,js,cjs,mjs}"
  ],
  "ignoreBinaries": [
    "dot"
  ],
  "ignoreExportsUsedInFile": true
}
