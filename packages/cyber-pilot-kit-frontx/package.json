{
  "name": "@gears-frontx/cyber-pilot-kit-frontx",
  "version": "0.3.0-alpha.5",
  "description": "FrontX AI Tooling Kit — ecosystem-level AI capabilities for AI agents working in FrontX projects",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    ".cf-studio-kit.toml",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "guidelines",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false"
  },
  "devDependencies": {
    "@gears-frontx/test-support": "0.1.0-alpha.0",
    "@vitest/coverage-v8": "4.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.2",
    "vitest": "4.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "cf-studio",
    "ai-kit",
    "ecosystem"
  ],
  "license": "MIT",
  "dependencies": {
    "smol-toml": "1.7.2"
  }
}
