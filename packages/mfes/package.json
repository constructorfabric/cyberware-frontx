{
  "name": "@gears-frontx/mfes",
  "version": "0.3.0-alpha.4",
  "description": "MFE runtime substrate for FrontX — registration, loading, extension-domain governance, mediation, and isolation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@gears-frontx/gts-plugin": "^0.3.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@gears-frontx/gts-plugin": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && node scripts/verify-dist-import-pragmas.mjs",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "26.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "mfe",
    "microfrontend",
    "runtime",
    "typescript"
  ],
  "author": "Cyber Fabric",
  "license": "Apache-2.0"
}
