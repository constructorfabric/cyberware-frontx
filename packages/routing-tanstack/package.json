{
  "name": "@gears-frontx/routing-tanstack",
  "version": "0.3.0-alpha.0",
  "description": "FrontX's default routing-engine provider - binds the navigation substrate's shared history to TanStack Router, projecting each occupant's own entry into a virtual location that engine can navigate",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch"
  },
  "dependencies": {
    "@gears-frontx/routing": "0.3.0-alpha.0",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/router-core": "^1.171.29"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "26.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.4.2",
    "vitest": "4.1.4"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "routing",
    "navigation",
    "router",
    "tanstack",
    "typescript"
  ],
  "author": "Cyber Fabric",
  "license": "Apache-2.0"
}
