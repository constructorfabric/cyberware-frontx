{
  "name": "@gears-frontx/api",
  "version": "0.3.0-alpha.2",
  "description": "API communication protocols and service registry for FrontX SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "llms.txt",
    "commands"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest --run --passWithNoTests=false --exclude='**/*.integration.test.ts'",
    "test:integration": "vitest --run --passWithNoTests=false --testTimeout=15000 --hookTimeout=15000 .integration.test",
    "test:unit:watch": "vitest --watch --exclude='**/*.integration.test.ts'"
  },
  "devDependencies": {
    "@gears-frontx/depcruise-config": "0.3.0-alpha.0",
    "@gears-frontx/eslint-config": "0.2.0-alpha.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.4",
    "axios": "1.14.0",
    "lodash": "4.18.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "axios": "1.14.0"
  },
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "api",
    "rest",
    "sse",
    "typescript"
  ],
  "author": "Cyber Fabric",
  "license": "Apache-2.0"
}
