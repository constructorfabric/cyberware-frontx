{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "stripInternal": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "noImplicitThis": true,

    /* Path aliases (ecosystem packages only — template packages carry their
       own tsconfig in the self-contained template-shell/) */
    "baseUrl": ".",
    "paths": {
      "@gears-frontx/api": ["./packages/api/src/index.ts"],
      "@gears-frontx/api/*": ["./packages/api/src/*"],
      "@gears-frontx/gts-plugin": ["./packages/gts-plugin/src/index.ts"],
      "@gears-frontx/gts-plugin/*": ["./packages/gts-plugin/src/*"],
      "@gears-frontx/mfes": ["./packages/mfes/src/index.ts"],
      "@gears-frontx/mfes/*": ["./packages/mfes/src/*"],
      "@gears-frontx/routing": ["./packages/routing/src/index.ts"],
      "@gears-frontx/routing/*": ["./packages/routing/src/*"],
      "@gears-frontx/routing-tanstack": ["./packages/routing-tanstack/src/index.ts"],
      "@gears-frontx/routing-tanstack/*": ["./packages/routing-tanstack/src/*"],
      "@gears-frontx/telemetry": ["./packages/telemetry/src/index.ts"],
      "@gears-frontx/telemetry/*": ["./packages/telemetry/src/*"],
      "@gears-frontx/ui-kit": ["./packages/ui-kit/src/index.ts"],
      "@gears-frontx/ui-kit/*": ["./packages/ui-kit/src/*"]
    }
  },
  // Ecosystem packages only. The host app + template packages (state, i18n,
  // framework, react, studio, auth) type-check via template-shell's own
  // tsconfig.app.json / per-package tsconfig.json (Phase 11 template-move).
  "include": ["packages/*/src"],
  "exclude": [
    "packages/*/dist",
    "packages/*/__tests__",
    "packages/*/src/__tests__",
    "**/__tests__"
  ]
}
