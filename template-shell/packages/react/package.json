{
  "name": "@gears-frontx/react",
  "version": "0.2.0-alpha.6",
  "description": "React bindings and hooks for FrontX framework",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-redux": "7.1.34",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "9.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@gears-frontx/framework": "*",
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "9.3.0"
  },
  "peerDependenciesMeta": {
    "@gears-frontx/framework": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "react-redux": {
      "optional": false
    },
    "@tanstack/react-query": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "react",
    "hooks",
    "provider",
    "typescript"
  ],
  "author": "Cyber Fabric",
  "license": "Apache-2.0"
}
