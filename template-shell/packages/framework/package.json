{
  "name": "@gears-frontx/framework",
  "version": "0.2.0-alpha.5",
  "description": "FrontX framework integrating all SDK packages with plugin architecture",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch"
  },
  "dependencies": {
    "path-to-regexp": "8.4.2"
  },
  "devDependencies": {
    "@gears-frontx/auth": "*",
    "@gears-frontx/frontx-template-shell": "file:../..",
    "@gears-frontx/mfes": "0.3.0-alpha.4",
    "@gears-frontx/gts-plugin": "0.3.0-alpha.4",
    "@reduxjs/toolkit": "2.12.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.4",
    "@tanstack/query-core": "5.101.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@gears-frontx/auth": "*",
    "@gears-frontx/state": "*",
    "@gears-frontx/mfes": "*",
    "@gears-frontx/gts-plugin": "*",
    "@gears-frontx/api": "*",
    "@gears-frontx/i18n": "*",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/query-core": "5.101.4",
    "vitest": "4.1.4"
  },
  "peerDependenciesMeta": {
    "@gears-frontx/auth": {
      "optional": false
    },
    "@gears-frontx/state": {
      "optional": false
    },
    "@gears-frontx/mfes": {
      "optional": false
    },
    "@gears-frontx/gts-plugin": {
      "optional": false
    },
    "@gears-frontx/api": {
      "optional": false
    },
    "@gears-frontx/i18n": {
      "optional": false
    },
    "@reduxjs/toolkit": {
      "optional": false
    },
    "@tanstack/query-core": {
      "optional": false
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "framework",
    "plugin",
    "screenset",
    "typescript"
  ],
  "author": "Cyber Fabric",
  "license": "Apache-2.0"
}
