{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "stripInternal": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "noImplicitThis": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src-app/*"],
      "@/app/*": ["./src-app/app/*"],
      "@/mfe_packages/*": ["./src-app/mfe_packages/*"],
      "@/screensets/*": ["./src-app/screensets/*"],
      "@gears-frontx/state": ["./packages/state/src/index.ts"],
      "@gears-frontx/state/*": ["./packages/state/src/*"],
      "@gears-frontx/i18n": ["./packages/i18n/src/index.ts"],
      "@gears-frontx/i18n/*": ["./packages/i18n/src/*"],
      "@gears-frontx/frontx-template-shell": ["./src/index.ts"],
      "@gears-frontx/frontx-template-shell/*": ["./src/*"],
      "@gears-frontx/framework": ["./packages/framework/src/index.ts"],
      "@gears-frontx/framework/*": ["./packages/framework/src/*"],
      "@gears-frontx/react": ["./packages/react/src/index.ts"],
      "@gears-frontx/react/*": ["./packages/react/src/*"],
      "@gears-frontx/studio": ["./packages/studio/src/index.ts"],
      "@gears-frontx/studio/*": ["./packages/studio/src/*"],
      "@gears-frontx/auth": ["./packages/auth/src/index.ts"],
      "@gears-frontx/auth/*": ["./packages/auth/src/*"],
      "@gears-frontx/mfe-test-support": ["./packages/mfe-test-support/index.ts"],
      "@gears-frontx/mfe-test-support/*": ["./packages/mfe-test-support/*"]
    }
  },
  "include": [
    "src-app",
    "packages/*/src"
  ],
  "exclude": [
    "packages/*/dist",
    "packages/*/__tests__",
    "packages/*/src/__tests__",
    "**/__tests__",
    "src-app/mfe_packages"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
