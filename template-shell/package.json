{
  "name": "@gears-frontx/frontx-template-shell",
  "version": "0.1.0-alpha.4",
  "description": "Standard FrontX application template \u2014 target scaffold for template-side code relocation",
  "private": true,
  "type": "module",
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    },
    "./build/mf-gts": {
      "types": "./dist-lib/build/mf-gts.d.ts",
      "import": "./dist-lib/build/mf-gts.js",
      "require": "./dist-lib/build/mf-gts.cjs"
    }
  },
  "files": [
    "dist-lib"
  ],
  "workspaces": [
    "packages/*",
    "src-app/mfe_packages/*",
    "src-app/verify_packages/*"
  ],
  "scripts": {
    "prebuild:mfes": "npm run build:packages",
    "build:mfes": "npx tsx scripts/build-mfes.ts",
    "generate:mfe-manifests": "npx tsx scripts/generate-mfe-manifests.ts",
    "dev": "npm run build:mfes && npm run generate:mfe-manifests && vite",
    "predev:all": "npm run build:packages",
    "dev:all": "npx tsx scripts/dev-all.ts",
    "preview": "vite preview",
    "build:package": "tsup",
    "build:packages:auth": "npm run build --workspace=@gears-frontx/auth",
    "build:packages:state": "npm run build --workspace=@gears-frontx/state",
    "build:packages:i18n": "npm run build --workspace=@gears-frontx/i18n",
    "build:packages:framework": "npm run build --workspace=@gears-frontx/framework",
    "build:packages:react": "npm run build --workspace=@gears-frontx/react",
    "build:packages:studio": "npm run build --workspace=@gears-frontx/studio",
    "prebuild:packages": "npm run build:package",
    "build:packages": "npm run build:packages:auth && npm run build:packages:state && npm run build:packages:i18n && npm run build:packages:framework && npm run build:packages:react && npm run build:packages:studio",
    "build": "npm run build:mfes && npm run generate:mfe-manifests && vite build",
    "type-check:package": "tsc --noEmit",
    "type-check:package:test": "tsc -p tsconfig.test.json",
    "type-check:app": "tsc --noEmit -p tsconfig.app.json",
    "type-check:packages:auth": "npm run type-check --workspace=@gears-frontx/auth",
    "type-check:packages:state": "npm run type-check --workspace=@gears-frontx/state",
    "type-check:packages:i18n": "npm run type-check --workspace=@gears-frontx/i18n",
    "type-check:packages:framework": "npm run type-check --workspace=@gears-frontx/framework",
    "type-check:packages:react": "npm run type-check --workspace=@gears-frontx/react",
    "type-check:packages:studio": "npm run type-check --workspace=@gears-frontx/studio",
    "type-check:packages": "npm run type-check:packages:auth && npm run type-check:packages:state && npm run type-check:packages:i18n && npm run type-check:packages:framework && npm run type-check:packages:react && npm run type-check:packages:studio",
    "type-check:scripts": "tsc -p tsconfig.scripts.json",
    "type-check:mfe": "npx tsx scripts/run-mfe-type-checks.ts",
    "type-check": "npm run type-check:package && npm run type-check:package:test && npm run type-check:app && npm run type-check:scripts && npm run type-check:packages && npm run type-check:mfe",
    "lint:sdk": "eslint packages/state/src packages/i18n/src --max-warnings 0",
    "lint:framework": "eslint packages/framework/src --max-warnings 0",
    "lint:react": "eslint packages/react/src --max-warnings 0",
    "lint": "eslint . --max-warnings 0",
    "arch:deps": "npx dependency-cruiser src-app/ packages/ --config .dependency-cruiser.cjs --output-type err-long",
    "arch:plugins": "npm run test:unit --workspace=@gears-frontx/framework -- __tests__/plugin-system.test.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false && vitest --run --config src-app/vitest.config.ts --passWithNoTests=false && npm run test:unit --workspaces --if-present",
    "test:unit:watch": "vitest --watch"
  },
  "dependencies": {
    "@gears-frontx/api": "0.3.0-alpha.2",
    "@gears-frontx/gts-plugin": "0.3.0-alpha.5",
    "@gears-frontx/mfes": "0.3.0-alpha.5",
    "@gears-frontx/ui-kit": "0.4.0-alpha.3",
    "@hookform/resolvers": "5.2.2",
    "@iconify/react": "6.0.2",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-slot": "1.3.3",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.101.4",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "input-otp": "1.4.2",
    "lodash": "4.18.1",
    "lucide-react": "0.563.0",
    "react": "19.2.4",
    "react-day-picker": "9.12.0",
    "react-dom": "19.2.4",
    "react-hook-form": "7.68.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@gears-frontx/api": ">=0.2.0-0",
    "@gears-frontx/mfes": "*",
    "esbuild": "0.28.2",
    "vite": "6.4.3"
  },
  "overrides": {
    "@gears-frontx/frontx-template-shell": "file:."
  },
  "peerDependenciesMeta": {
    "@gears-frontx/api": {
      "optional": false
    },
    "esbuild": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@globaltypesystem/gts-ts": "0.3.0",
    "@module-federation/vite": "1.20.5",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/lodash": "4.17.20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.4",
    "autoprefixer": "10.4.23",
    "dependency-cruiser": "17.3.10",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "15.12.0",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.1",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "4.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "frontx",
    "template",
    "typescript"
  ],
  "author": "Cyber Fabric",
  "license": "Apache-2.0"
}
